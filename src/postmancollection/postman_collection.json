              "cookie": [],
              "body": "{\n  \"code\": 200,\n  \"message\": \"ok\",\n  \"data\": {\n    \"status\": \"UP\",\n    \"application\": \"personpecipebackend\",\n    \"userId\": 1\n  }\n}"
            },
