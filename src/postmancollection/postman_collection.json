  "item": [
    {
      "name": "01 - 认证",
      "item": [
        {
          "name": "微信登录（首次自动注册）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 状态正确', () => pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 500]));",
                  "const json = pm.response.json();",
                  "if (json.code === 200 && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  console.log('Token 已自动保存');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{wxCode}}\",\n  \"nickname\": \"Postman测试用户\",\n  \"avatarUrl\": \"https://example.com/avatar.png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/wx-login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "wx-login"
              ]
            },
            "description": "使用 wx.login() 返回的 code 换取 JWT。首次登录按 openid 自动注册，JWT 有效期 7 天。本地 mock 模式下 code 直接作为 openid。"
          },
          "response": [
            {
              "name": "成功 - 登录或自动注册",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"code\": 200,\n  \"message\": \"ok\",\n  \"data\": {\n    \"token\": \"eyJhbGciOiJIUzM4NCJ9.example.signature\",\n    \"expiresIn\": 604800,\n    \"user\": {\n      \"id\": 1,\n      \"nickname\": \"Postman测试用户\",\n      \"avatarUrl\": \"https://example.com/avatar.png\"\n    }\n  }\n}"
            },
            {
              "name": "失败 - code 为空",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"code\": 400,\n  \"message\": \"code 不能为空\",\n  \"data\": null\n}"
            },
            {
              "name": "失败 - 微信 code 无效",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"code\": 401,\n  \"message\": \"微信登录失败: invalid code\",\n  \"data\": null\n}"
            }
          ]
        },
        {
          "name": "退出登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 200) {",
                  "  pm.collectionVariables.unset('token');",
                  "  console.log('本地 Token 已清除');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "将当前 JWT 的 jti 写入 Redis 黑名单，TTL 等于 Token 剩余有效期，并清空用户 session_key。请求成功后测试脚本会清除集合变量 token。"
          },
          "response": [
            {
              "name": "成功 - 退出登录",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"code\": 200,\n  \"message\": \"ok\",\n  \"data\": null\n}"
            },
            {
              "name": "失败 - 未携带 Token",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"code\": 401,\n  \"message\": \"未登录或缺少 Token\",\n  \"data\": null\n}"
            },
            {
              "name": "失败 - Token 已登出",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"code\": 401,\n  \"message\": \"登录已失效，请重新登录\",\n  \"data\": null\n}"
            }
          ]
